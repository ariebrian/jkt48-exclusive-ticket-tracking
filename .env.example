# Supabase (server-only — no NEXT_PUBLIC_ prefix, no client-side Supabase usage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cron route auth — /api/cron/snapshot is a manual/backup bulk-refresh
# trigger (curl it by hand), not the primary freshness mechanism (that's
# the visit-triggered refresh below). Set this to a long random string; only
# wire up an external scheduler (cron-job.org / GitHub Actions) if you want
# scheduled bulk refreshes too:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Admin auth (single shared password, no user table)
# Generate the hash with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# Escape every "$" as "\$" — Next.js's env loader (dotenv-expand) treats
# unescaped "$name" as variable interpolation and silently truncates the
# hash. Quoting the value does NOT prevent this; only backslash-escaping does.
# Example: ADMIN_PASSWORD_HASH=\$2b\$10\$8bn8O5vbMRhuw9/H38jxQOHl5xNGr1X0FSll2bBcbjUg9JDUzvr8.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional overrides
# JKT48_API_BASE=https://jkt48.com/api/v1/exclusives
# SNAPSHOT_DELAY_MS=750
# STALE_THRESHOLD_MS=60000
